# Commit-safe form (issue #1870): the liberty below is written relative
# to $PDK_ROOT, which Yosys does NOT expand -- this file is the artifact
# to commit, not the one to run. Run the rehydrated sibling
# 'synth_usb_utmi_phy.run.ys' (regenerated by every `klt synthesize` run), or
# substitute your own PDK install root for $PDK_ROOT first.
read_verilog rtl/common/usb_nrzi_encoder.v
read_verilog rtl/common/usb_nrzi_decoder.v
read_verilog rtl/common/usb_bit_stuffer.v
read_verilog rtl/common/usb_bit_destuffer.v
read_verilog rtl/usb_sync_detector.v
read_verilog rtl/usb_eop_detector.v
read_verilog rtl/usb_line_state_decode.v
read_verilog rtl/usb_utmi_phy.v
hierarchy -check -top usb_utmi_phy
synth -top usb_utmi_phy
dfflibmap -liberty $PDK_ROOT/volare/gf180mcu/versions/c6d73a35f524070e85faff4a6a9eef49553ebc2b/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu9t5v0/lib/gf180mcu_fd_sc_mcu9t5v0__tt_025C_1v80.lib
tee -q -o flow/.klt/synthesize/run-28310edc84544193a936eb3410334969/usb_utmi_phy_abc.log abc -liberty $PDK_ROOT/volare/gf180mcu/versions/c6d73a35f524070e85faff4a6a9eef49553ebc2b/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu9t5v0/lib/gf180mcu_fd_sc_mcu9t5v0__tt_025C_1v80.lib -constr flow/.klt/synthesize/run-28310edc84544193a936eb3410334969/usb_utmi_phy_abc.constr
clean
setundef -zero
hilomap -hicell gf180mcu_fd_sc_mcu9t5v0__tieh Z -locell gf180mcu_fd_sc_mcu9t5v0__tiel ZN
tee -q -o flow/.klt/synthesize/run-28310edc84544193a936eb3410334969/usb_utmi_phy_stats.json stat -liberty $PDK_ROOT/volare/gf180mcu/versions/c6d73a35f524070e85faff4a6a9eef49553ebc2b/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu9t5v0/lib/gf180mcu_fd_sc_mcu9t5v0__tt_025C_1v80.lib -json -top usb_utmi_phy
write_verilog -noattr flow/.klt/synthesize/run-28310edc84544193a936eb3410334969/usb_utmi_phy_synth.v
