.DS_Store

# sim/ harness: per-corner ngspice logs under corners/ are committed evidence
# (append-only record trail), so they escape the *.log rule.
!sim/*/corners/**/*.log
sim/build/
# sim/ harness: generated ngspice decks are disposable scratch, never evidence
sim/.work/
# sim/ harness: machine-local PDK override (see sim/harness/pdk.py)
sim/pdk.local.json
# synthesis / place-and-route scratch
flow/build/
# analog layout-plan scratch (scripts/gen_analog_layout.py) -- the committed
# evidence lives under verification/records/analog-layout/ instead
layout/analog/out/
# local klt install, created by the setup script
.venv/

# klt / cocotb / Icarus scratch (ad-hoc `klt functional-verification` /
# `klt synthesize` runs) -- never committed; deliberate evidence lands
# under verification/records/ instead.
.klt/
**/.klt/
sim_build*/
results.xml
results_icarus.xml
