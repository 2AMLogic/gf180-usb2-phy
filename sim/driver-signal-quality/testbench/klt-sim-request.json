{
  "netlist": "driver_tb_klt.spice",
  "engine": "ngspice",
  "backend": "batch",
  "models": {
    "pdk": "gf180mcuD",
    "lib": "libs.tech/ngspice/sm141064.ngspice"
  },
  "corners": {
    "process": [
      {
        "name": "tt",
        "sections": [
          "typical",
          "res_typical",
          "bjt_typical",
          "diode_typical",
          "moscap_typical",
          "mimcap_typical"
        ]
      },
      {
        "name": "ff",
        "sections": [
          "ff",
          "res_ff",
          "bjt_ff",
          "diode_ff",
          "moscap_ff",
          "mimcap_ff"
        ]
      },
      {
        "name": "ss",
        "sections": [
          "ss",
          "res_ss",
          "bjt_ss",
          "diode_ss",
          "moscap_ss",
          "mimcap_ss"
        ]
      },
      {
        "name": "fs",
        "sections": [
          "fs",
          "res_typical",
          "bjt_typical",
          "diode_typical",
          "moscap_typical",
          "mimcap_typical"
        ]
      },
      {
        "name": "sf",
        "sections": [
          "sf",
          "res_typical",
          "bjt_typical",
          "diode_typical",
          "moscap_typical",
          "mimcap_typical"
        ]
      }
    ],
    "supply_v": {
      "vsup": [
        2.97,
        3.3,
        3.63
      ]
    },
    "temperature_c": [
      -40,
      27,
      125
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "20p 300n"
  },
  "measurements": [
    {
      "name": "t_rise",
      "spice": ".meas tran t_rise TRIG v(dpn) VAL=0.1 RISE=1 TARG v(dpn) VAL=0.9 RISE=1",
      "unit": "s"
    },
    {
      "name": "t_fall",
      "spice": ".meas tran t_fall TRIG v(dpn) VAL=0.9 FALL=1 TARG v(dpn) VAL=0.1 FALL=1",
      "unit": "s"
    },
    {
      "name": "t_xr",
      "spice": ".meas tran t_xr WHEN v(dp)=v(dm) CROSS=1",
      "unit": "s"
    },
    {
      "name": "t_xf",
      "spice": ".meas tran t_xf WHEN v(dp)=v(dm) CROSS=2",
      "unit": "s"
    },
    {
      "name": "t_xlast",
      "spice": ".meas tran t_xlast WHEN v(dp)=v(dm) CROSS=LAST",
      "unit": "s"
    },
    {
      "name": "dp_max",
      "spice": ".meas tran dp_max MAX v(dp)",
      "unit": "V"
    },
    {
      "name": "dp_min",
      "spice": ".meas tran dp_min MIN v(dp)",
      "unit": "V"
    },
    {
      "name": "vdd_max",
      "spice": ".meas tran vdd_max MAX v(vdd)",
      "unit": "V"
    },
    {
      "name": "trise_ns",
      "spice": ".meas tran trise_ns param='t_rise*1e9'",
      "unit": "ns",
      "limits": {
        "min": 4.0,
        "max": 20.0
      }
    },
    {
      "name": "tfall_ns",
      "spice": ".meas tran tfall_ns param='t_fall*1e9'",
      "unit": "ns",
      "limits": {
        "min": 4.0,
        "max": 20.0
      }
    },
    {
      "name": "trf_ratio",
      "spice": ".meas tran trf_ratio param='t_rise/t_fall'",
      "limits": {
        "min": 0.9,
        "max": 1.1
      }
    },
    {
      "name": "vcross_rise",
      "spice": ".meas tran vcross_rise FIND v(dp) WHEN v(dp)=v(dm) CROSS=1",
      "unit": "V",
      "limits": {
        "min": 1.3,
        "max": 2.0
      }
    },
    {
      "name": "vcross_fall",
      "spice": ".meas tran vcross_fall FIND v(dp) WHEN v(dp)=v(dm) CROSS=2",
      "unit": "V",
      "limits": {
        "min": 1.3,
        "max": 2.0
      }
    },
    {
      "name": "xing_extra_ps",
      "spice": ".meas tran xing_extra_ps param='(t_xlast-t_xf)*1e12'",
      "unit": "ps",
      "limits": {
        "min": -1.0,
        "max": 1.0
      }
    },
    {
      "name": "dp_over_mv",
      "spice": ".meas tran dp_over_mv param='(dp_max-vdd_max)*1e3'",
      "unit": "mV",
      "limits": {
        "min": -50.0,
        "max": 50.0
      }
    },
    {
      "name": "dp_under_mv",
      "spice": ".meas tran dp_under_mv param='dp_min*1e3'",
      "unit": "mV",
      "limits": {
        "min": -50.0,
        "max": 50.0
      }
    }
  ],
  "options": {
    "timeout_s": 900,
    "keep_artifacts": true
  },
  "batch": {
    "poll_interval_s": 30,
    "poll_timeout_s": 5400
  },
  "remote": {
    "hosts": 5
  }
}
